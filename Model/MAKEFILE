CC = cc68x

tstmodel.tos: asynch.o cond.o synch.o meter.o model.o note.o tstmodel.o
	$(CC) -g asynch.o cond.o synch.o meter.o model.o note.o tstmodel.o -o tstmodel.tos

note.o: note.c note.h types.h
	$(CC) -g -c note.c 

asynch.o: asynch.c asynch.h cond.h model.h note.h meter.h types.h
	$(CC) -g -c asynch.c

cond.o: cond.c cond.h model.h note.h meter.h types.h
	$(CC) -g -c cond.c

meter.o: meter.c meter.h types.h
	$(CC) -g -c meter.c

model.o: model.c model.h note.h meter.h types.h
	$(CC) -g -c model.c

synch.o: synch.c synch.h cond.h model.h note.h meter.h types.h
	$(CC) -g -c synch.c

tstmodel.o: tstmodel.c events.h asynch.h synch.h cond.h model.h note.h meter.h types.h
	$(CC) -g -c tstmodel.c