# ==== Keywords ====

game: pocket.tos
all: model render raster live
model: tstmodel.tos
render: tstrend.tos
raster: tstrast.tos
live: tstlive.tos

# ==== SYSTEM CALLS ====
# No ext dependencies
SYSTEM =	build\system.o

build\system.o:
	cc68x -g -c system\system.c -o build\system.o

# ==== MODEL OBJECTS ====
# No ext dependencies
MODEL =	build\model.o build\meter.o build\note.o

build\model.o: model\model.c build\meter.o build\note.o types.h
	cc68x -g -c model\model.c -o build\model.o

build\meter.o: model\meter.c model\meter.h types.h
	cc68x -g -c model\meter.c -o build\meter.o

build\note.o: model\note.c model\note.h types.h
	cc68x -g -c model\note.c -o build\note.o

# ==== EVENT OBJECTS ====
# Also builds model objects by default
EVENTS =	build\asynch.o build\cond.o build\synch.o

build\asynch.o: events\asynch.c events\asynch.h events\events.h build\model.o types.h
	cc68x -g -c events\asynch.c -o build\asynch.o

build\cond.o: events\cond.c events\cond.h events\events.h build\model.o types.h
	cc68x -g -c events\cond.c -o build\cond.o

build\synch.o: events\synch.c events\synch.h events\events.h build\model.o types.h
	cc68x -g -c events\synch.c -o build\synch.o

# ==== BITMAPS ====
# No ext dependencies
BITMAPS =	bitmaps\bitmaps.o build\targets.o

bitmaps\bitmaps.o: bitmaps\bitmaps.s
	gen -D -L2 bitmaps\bitmaps.s

build\targets.o: bitmaps\targets.c bitmaps\bitmaps.h types.h
	cc68x -g -c bitmaps\targets.c -o build\targets.o

# ==== RASTER OBJECTS ====
# No ext dependencies
RASTER =	raster\rast_asm.o raster\bitmap.o raster\fill.o raster\fonts.o raster\string.o

raster\rast_asm.o: raster\rast_asm.s
	gen -D -L2 raster\rast_asm.s

raster\bitmap.o: raster\bitmap.s
	gen -D -L2 raster\bitmap.s

raster\fill.o: raster\fill.s
	gen -D -L2 raster\fill.s

raster\fonts.o: raster\fonts.s
	gen -D -L2 raster\fonts.s

raster\string.o: raster\string.s
	gen -D -L2 raster\string.s

# ==== RENDER OBJECTS ====
# Also builds raster and bitmap objects
RENDER =	build\render.o

build\render.o: render\render.c render\render.h build\model.o $(RASTER) $(BITMAPS) types.h
	cc68x -g -c render\render.c -o build\render.o

# ==== GAME MODULE ====
# Builds all objects (except tests)

pocket.tos: build\pocket.o $(MODEL) $(EVENTS) $(RASTER) $(BITMAPS) $(RENDER) $(SYSTEM)
	cc68x -g build\pocket.o $(MODEL) $(EVENTS) $(RASTER) $(BITMAPS) $(RENDER) $(SYSTEM) -o pocket.tos

build\pocket.o: pocket.c
	cc68x -g -c pocket.c -o build\pocket.o

# ==== MODEL/EVENT TESTS ====
tstmodel.tos: $(EVENTS) $(MODEL) build\tstmodel.o
	cc68x -g $(EVENTS) $(MODEL) build\tstmodel.o -o tstmodel.tos

build\tstmodel.o: model\tstmodel.c $(EVENTS_H) $(MODEL_H) types.h
	cc68x -g -c model\tstmodel.c -o build\tstmodel.o

# ==== RENDER TESTS ====
tstrend.tos: build\tstrend.o build\render.o $(BITMAPS) $(EVENTS) $(MODEL) $(RASTER)
	cc68x -g build\tstrend.o build\render.o $(BITMAPS) $(EVENTS) $(MODEL) $(RASTER) -o tstrend.tos

tstlive.tos: build\tstlive.o build\render.o $(BITMAPS) $(EVENTS) $(MODEL) $(RASTER)
	cc68x -g build\tstlive.o build\render.o $(BITMAPS) $(EVENTS) $(MODEL) $(RASTER) -o tstlive.tos

build\tstrend.o: render\tstrend.c render\render.h raster\raster.h $(EVENTS_H) $(MODEL_H) types.h
	cc68x -g -c render\tstrend.c -o build\tstrend.o

build\tstlive.o: render\tstlive.c render\render.h raster\raster.h $(EVENTS_H) $(MODEL_H) types.h
	cc68x -g -c render\tstlive.c -o build\tstlive.o

# ==== RASTER TESTS ====

RASTER_TST	=	build\tstrast.o build\test_clr.o build\test_ln.o\
 build\test_shp.o build\test_bmp.o build\test_str.o

tstrast.tos: $(RASTER) $(RASTER_TST) $(BITMAPS)
	cc68x -g $(RASTER) $(RASTER_TST) $(BITMAPS) -o tstrast.tos

build\tstrast.o: raster\tests\tests.c raster\tests\tests.h raster\raster.h
	cc68x -g -c raster\tests\tests.c -o build\tstrast.o

build\test_clr.o: raster\tests\test_clr.c raster\tests\tests.h raster\raster.h
	cc68x -g -c raster\tests\test_clr.c -o build\test_clr.o

build\test_ln.o: raster\tests\test_ln.c raster\tests\tests.h raster\raster.h
	cc68x -g -c raster\tests\test_ln.c -o build\test_ln.o

build\test_shp.o: raster\tests\test_shp.c raster\tests\tests.h raster\raster.h
	cc68x -g -c raster\tests\test_shp.c -o build\test_shp.o

build\test_bmp.o: raster\tests\test_bmp.c raster\tests\tests.h raster\raster.h
	cc68x -g -c raster\tests\test_bmp.c -o build\test_bmp.o

build\test_str.o: raster\tests\test_str.c raster\tests\tests.h raster\raster.h
	cc68x -g -c raster\tests\test_str.c -o build\test_str.o
