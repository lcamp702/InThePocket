# === Keywords ====

all: model render raster
model: tstmodel.tos
render: tstrend.tos
raster: tstrast.tos

# ==== MODEL OBJECTS ====

build\model.o: model\model.c model\model.h model\note.h model\meter.h types.h
	cc68x -g -c model\model.c -o build\model.o

build\meter.o: model\meter.c model\meter.h types.h
	cc68x -g -c model\meter.c -o build\meter.o

build\note.o: model\note.c model\note.h types.h
	cc68x -g -c model\note.c -o build\note.o

# ==== EVENT OBJECTS ====

build\asynch.o: events\asynch.c events\asynch.h events\cond.h model\model.h model\note.h model\meter.h types.h
	cc68x -g -c events\asynch.c -o build\asynch.o

build\cond.o: events\cond.c events\cond.h model\model.h model\note.h model\meter.h types.h
	cc68x -g -c events\cond.c -o build\cond.o

build\synch.o: events\synch.c events\synch.h events\cond.h model\model.h model\note.h model\meter.h types.h
	cc68x -g -c events\synch.c -o build\synch.o

# ==== RENDER OBJECTS ====

build\render.o: render\render.c render\render.h render\bitmaps.h raster\raster.h model\model.h model\note.h model\meter.h types.h
	cc68x -g -c render\render.c -o build\render.o

build\bitmaps.o: render\bitmaps.c render\bitmaps.h types.h
	cc68x -g -c render\bitmaps.c -o build\bitmaps.o

# ==== RASTER OBJECTS ====

raster\rast_asm.o: raster\rast_asm.s
	gen -D -L2 raster\rast_asm.s

# ==== MODEL/EVENT TESTS ====
tstmodel.tos: build\asynch.o build\cond.o build\synch.o build\meter.o build\model.o build\note.o build\tstmodel.o
	cc68x -g build\asynch.o build\cond.o build\synch.o build\meter.o build\model.o build\note.o build\tstmodel.o -o tstmodel.tos

build\tstmodel.o: model\tstmodel.c events\events.h events\asynch.h events\synch.h events\cond.h model\model.h model\note.h model\meter.h types.h
	cc68x -g -c model\tstmodel.c -o build\tstmodel.o

# ==== RENDER TESTS ====
tstrend.tos: build\tstrend.o build\render.o build\bitmaps.o build\asynch.o build\synch.o build\cond.o build\model.o build\note.o build\meter.o raster\rast_asm.o
	cc68x -g build\tstrend.o build\render.o build\bitmaps.o build\asynch.o build\synch.o build\cond.o build\model.o build\note.o build\meter.o raster\rast_asm.o -o tstrend.tos

build\tstrend.o: render\tstrend.c events\events.h events\asynch.h events\synch.h events\cond.h render\render.h raster\raster.h model\model.h model\note.h model\meter.h types.h
	cc68x -g -c render\tstrend.c -o build\tstrend.o

# ==== RASTER TESTS ====

tstrast.tos: raster\rast_asm.o build\tstrast.o build\test_clr.o build\test_ln.o build\test_shp.o build\test_bmp.o build\test_str.o
	cc68x -g raster\rast_asm.o build\tstrast.o build\test_clr.o build\test_ln.o build\test_shp.o build\test_bmp.o build\test_str.o -o tstrast.tos

build\tstrast.o: raster\tests\tests.c raster\tests\tests.h raster\raster.h
	cc68x -g -c raster\tests\tests.c -o build\tstrast.o

build\test_clr.o: raster\tests\test_clr.c raster\tests\tests.h raster\raster.h
	cc68x -g -c raster\tests\test_clr.c -o build\test_clr.o

build\test_ln.o: raster\tests\test_ln.c raster\tests\tests.h raster\raster.h
	cc68x -g -c raster\tests\test_ln.c -o build\test_ln.o

build\test_shp.o: raster\tests\test_shp.c raster\tests\tests.h raster\raster.h
	cc68x -g -c raster\tests\test_shp.c -o build\test_shp.o

build\test_bmp.o: raster\tests\test_bmp.c raster\tests\tests.h raster\raster.h
	cc68x -g -c raster\tests\test_bmp.c -o build\test_bmp.o

build\test_str.o: raster\tests\test_str.c raster\tests\tests.h raster\raster.h
	cc68x -g -c raster\tests\test_str.c -o build\test_str.o
